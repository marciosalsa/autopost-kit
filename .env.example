# Copy this file to .env and fill in the values. .env is ignored by git.
# Collecting and building posts work without any of these.

# Instagram API with Unified Login (system user token from the Meta app dashboard).
# INSTAGRAM_USER_ID is optional: the account shared with the token is found automatically.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
INSTAGRAM_API_VERSION=v26.0

# Private S3 bucket used to hand media to Instagram through temporary links.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2
AUTOPOST_S3_BUCKET=
